# Configurações de Paralelização para Sistema de Loterias
# Este arquivo define as configurações do sistema de execução paralela

# =============================================================================
# CONFIGURAÇÕES DE WORKERS
# =============================================================================

# Número máximo de workers para execução paralela
# - Auto-detect: deixe comentado ou vazio
# - Valor recomendado: número de CPU cores (ou 2x para I/O-bound)
MAX_WORKERS=4

# Tipo de paralelização
# 0 = Threads (recomendado para I/O-bound: leitura de arquivos, APIs)
# 1 = Processos (recomendado para CPU-bound: treinamento de modelos)
USE_PROCESSES=0

# Habilitar/desabilitar paralelização
# 0 = Habilitado (padrão)
# 1 = Desabilitado (útil para debugging)
DISABLE_PARALLEL=0

# =============================================================================
# CONFIGURAÇÕES DE AMBIENTE
# =============================================================================

# Modo rápido para CI/CD
# 0 = Modo completo (todos os modelos)
# 1 = Modo rápido (modelos reduzidos, menos simulações)
FAST_CI=0

# Timeout para operações paralelas (em segundos)
# PARALLEL_TIMEOUT_PREDICT=300    # 5 minutos para predições
# PARALLEL_TIMEOUT_TRAIN=600      # 10 minutos para treinamentos

# =============================================================================
# CONFIGURAÇÕES ESPECÍFICAS DOS MODELOS
# =============================================================================

# Monte Carlo - Número de simulações
# MONTE_CARLO_SIMULATIONS=1000

# Neural Ensemble - Configurações de treinamento
# NEURAL_MAX_ITER=1000
# NEURAL_EARLY_STOPPING=1

# =============================================================================
# CONFIGURAÇÕES DE LOG E DEBUG
# =============================================================================

# Nível de verbosidade dos logs
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Habilitar logs detalhados de paralelização
PARALLEL_DEBUG=0

# =============================================================================
# EXEMPLOS DE CONFIGURAÇÃO POR AMBIENTE
# =============================================================================

# Para desenvolvimento local (máximo desempenho):
# MAX_WORKERS=8
# USE_PROCESSES=1
# FAST_CI=0

# Para CI/CD (execução rápida):
# MAX_WORKERS=2
# USE_PROCESSES=0
# FAST_CI=1

# Para debugging (execução sequencial):
# DISABLE_PARALLEL=1
# LOG_LEVEL=DEBUG
# PARALLEL_DEBUG=1